class Animal:
    def __init__(self, name):
        self.name = name

    def make_sound(self):
        return "..."
    
    def move(self):
        return f"{self.name} двигается."

class Dog(Animal):
    def make_sound(self):
        return "Гав!"

    def move(self):
        return f"{self.name} бежит на четырех лапах."

class Bird(Animal):
    def make_sound(self):
        return "Чирик!"

    def move(self):
        return f"{self.name} летит."

dog = Dog("Шарик")
bird = Bird("Кеша")

print(dog.make_sound())
print(dog.move())
print(bird.make_sound())
print(bird.move())

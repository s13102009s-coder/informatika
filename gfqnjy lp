import tkinter as tk

root = tk.Tk()
root.title("Калькулятор")

text_input = tk.Label(root, text="", anchor="e", bg="white", font=("Arial", 20))
text_input.grid(row=0, column=0, columnspan=4, sticky="ew")

text_result = tk.Label(root, text="", anchor="e", bg="white", font=("Arial", 16))
text_result.grid(row=1, column=0, columnspan=4, sticky="ew")

def multiply():
    try:
        parts = text_input.cget("text").split("*")
        text_result.config(text=str(float(parts[0]) * float(parts[1])))
    except:
        text_result.config(text="Ошибка")

def divide():
    try:
        parts = text_input.cget("text").split("/")
        text_result.config(text=str(float(parts[0]) / float(parts[1])))
    except:
        text_result.config(text="Ошибка")

def summy():
    try:
        parts = text_input.cget("text").split("+")
        text_result.config(text=str(float(parts[0]) + float(parts[1])))
    except:
        text_result.config(text="Ошибка")

def diff():
    try:
        parts = text_input.cget("text").split("-")
        text_result.config(text=str(float(parts[0]) - float(parts[1])))
    except:
        text_result.config(text="Ошибка")

def result():
    try:
        text_result.config(text=str(eval(text_input.cget("text"))))
    except:
        text_result.config(text="Ошибка")

def click_number(num):
    current = text_input.cget("text")
    text_input.config(text=current + str(num))

for i in range(10):
    btn = tk.Button(root, text=str(i), width=5, height=2, command=lambda n=i: click_number(n))
    btn.grid(row=2 + i // 3, column=i % 3, padx=2, pady=2)

operations = [
    ("*", multiply),
    ("/", divide),
    ("+", summy),
    ("-", diff),
    ("=", result)
]

for i, (sign, func) in enumerate(operations):
    btn = tk.Button(root, text=sign, width=5, height=2, command=func)
    btn.grid(row=2 + i, column=3, padx=2, pady=2)

root.mainloop()

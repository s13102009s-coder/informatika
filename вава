import tkinter as tk

class Interface:
    def __init__(self):
        # Создание главного объекта root (п. 4)
        self.root = tk.Tk()
        
        # Настройки компонента root (п. 5)
        self.root.title("Task Manager")
        self.root.geometry("600x400")
        self.root.configure(bg="#f0f0f0")

# Блок для проверки работы класса (необязательно, но полезно для теста)
if __name__ == "__main__":
    app = Interface()
    app.root.mainloop()
